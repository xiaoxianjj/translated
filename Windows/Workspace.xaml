<local:ToolWindow x:Class="Translated.Workspace" x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Translated"
  Title="Translated" Width="596" Height="740" MinWidth="465" MinHeight="510">
  <Grid Margin="28,26,28,18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel>
      <Border DockPanel.Dock="Right" CornerRadius="18" Background="{DynamicResource Soft}" VerticalAlignment="Center" Padding="11,4">
        <TextBlock x:Name="StateLabel" Style="{StaticResource Heading}" FontSize="12"/>
      </Border>
      <StackPanel Orientation="Horizontal">
        <Image Source="Assets/Brand.png" Width="62" Height="50" AutomationProperties.Name="A / 文"/>
        <TextBlock Text="Translated" FontSize="27" FontFamily="{StaticResource RoundFont}" FontWeight="Bold" Margin="13,0,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,20,0,24" CornerRadius="7" Background="{DynamicResource Soft}" HorizontalAlignment="Left">
      <StackPanel Orientation="Horizontal">
        <RadioButton x:Name="TranslateTab" Content="Translate" GroupName="Pages" IsChecked="True" Checked="PageChanged"/>
        <RadioButton x:Name="SettingsTab" Content="Settings" GroupName="Pages" Checked="PageChanged"/>
      </StackPanel>
    </Border>
    <ScrollViewer x:Name="EditorScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid x:Name="EditorPage">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="85"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="0"/></Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="English" Style="{StaticResource Heading}" FontSize="33"/>
        <TextBlock Text="⇄" FontSize="27" Foreground="{DynamicResource Muted}" Margin="14,0"/>
        <TextBlock Text="中文" FontFamily="Microsoft YaHei UI" FontSize="29" FontWeight="SemiBold"/>
      </StackPanel>
      <TextBlock x:Name="ShortcutHint" Grid.Row="1" Style="{StaticResource Hint}" FontSize="15" Margin="0,5,0,12"/>
      <DockPanel Grid.Row="2" Margin="0,4,0,15">
        <Button x:Name="Paste" DockPanel.Dock="Right" Click="PasteClick" Style="{StaticResource Quiet}" AutomationProperties.Name="Paste">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77F;" Margin="0,0,8,0"/><TextBlock Text="Paste"/></StackPanel>
        </Button>
        <TextBlock Text="Words or whole passages" Style="{StaticResource Heading}"/>
      </DockPanel>
      <Grid Grid.Row="3">
        <Border x:Name="EditorBorder" CornerRadius="12" Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <TextBox x:Name="Input" Background="Transparent" Padding="10,9" BorderThickness="0" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontSize="15" AutomationProperties.Name="Words or whole passages" TextChanged="InputChanged">
            <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/></ControlTemplate></TextBox.Template>
          </TextBox>
        </Border>
        <TextBlock x:Name="Placeholder" Text="Paste or type something…" Margin="11,9" FontSize="15" VerticalAlignment="Top" Foreground="{DynamicResource Muted}" IsHitTestVisible="False"/>
      </Grid>
      <DockPanel Grid.Row="4" Margin="0,20,0,0">
        <Button x:Name="TranslateButton" Click="TranslateClick" Style="{StaticResource Primary}" DockPanel.Dock="Right" ToolTip="Translate (Ctrl + Enter)" AutomationProperties.Name="Translate text">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE72A;" Margin="0,0,9,0"/><TextBlock Text="Translate"/></StackPanel>
        </Button>
        <Button x:Name="CancelButton" Content="Cancel" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="CancelClick" Margin="0,0,7,0" Visibility="Collapsed"/>
        <TextBlock x:Name="Count" Style="{StaticResource Hint}" Text="0 / 50,000"/>
      </DockPanel>
      <TextBlock x:Name="EditorStatus" Grid.Row="5" Style="{StaticResource Feedback}" VerticalAlignment="Top" Margin="0,12,0,0" Foreground="{DynamicResource Error}" AutomationProperties.LiveSetting="Polite"/>
      <Grid x:Name="OutputArea" Grid.Row="6" Margin="0,12,0,0" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,8">
          <Button x:Name="CopyOutput" Content="Copy" DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="CopyOutputClick" AutomationProperties.Name="Copy translation"/>
          <TextBlock Text="Translation" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="ManualOutput" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Translation"/>
      </Grid>
    </Grid>
    </ScrollViewer>
    <ScrollViewer x:Name="SettingsPage" Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources>
        <Style TargetType="ScrollBar">
          <Setter Property="Width" Value="10"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Margin="3,1,1,1">
              <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
              <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Selected}" CornerRadius="4"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
              <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
            </Track>
          </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ScrollViewer.Resources>
      <StackPanel Margin="0,0,5,4">
        <DockPanel Margin="0,0,0,12">
          <Border DockPanel.Dock="Right" Background="{DynamicResource Sage}" CornerRadius="15" Padding="9,5"><TextBlock x:Name="ActiveShortcut" FontFamily="Consolas" FontSize="12"/></Border>
          <TextBlock Text="Translation shortcut" Style="{StaticResource Heading}"/>
        </DockPanel>
        <WrapPanel>
          <CheckBox x:Name="Ctrl" Content="Ctrl" Style="{StaticResource Modifier}"/>
          <CheckBox x:Name="Alt" Content="Alt" Style="{StaticResource Modifier}"/>
          <CheckBox x:Name="Shift" Content="Shift" Style="{StaticResource Modifier}"/>
          <CheckBox x:Name="Win" Content="Win" Style="{StaticResource Modifier}"/>
        </WrapPanel>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="Apply" Content="Apply" Click="ApplyShortcut" Style="{StaticResource Primary}" DockPanel.Dock="Right"/>
          <Button Content="Reset" Click="ResetShortcut" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Margin="0,0,6,0"/>
          <StackPanel Orientation="Horizontal"><TextBlock Text="Key" Margin="0,0,8,0"/><ComboBox x:Name="KeyPicker" Width="72" VerticalAlignment="Center" AutomationProperties.Name="Shortcut key"/></StackPanel>
        </DockPanel>
        <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Feedback}" Foreground="{DynamicResource Error}" AutomationProperties.LiveSetting="Polite"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,19,0,20"/>
        <DockPanel Margin="0,0,0,12">
          <ComboBox x:Name="ProviderPicker" DockPanel.Dock="Right" Width="171" SelectionChanged="ProviderChanged" AutomationProperties.Name="Translation provider"/>
          <TextBlock Text="Translation provider" Style="{StaticResource Heading}"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Model"/><TextBox x:Name="Model" Grid.Column="1" Margin="0,2" AutomationProperties.Name="Model"/>
          <TextBlock Grid.Row="1" Text="API URL"/><TextBox x:Name="Address" Grid.Row="1" Grid.Column="1" Margin="0,2" AutomationProperties.Name="API URL" TextChanged="AddressChanged"/>
          <TextBlock Grid.Row="2" Text="API key"/>
          <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
            <PasswordBox x:Name="Secret" AutomationProperties.Name="API key" PasswordChanged="SecretChanged"/>
            <TextBlock x:Name="KeyHint" Style="{StaticResource Hint}" Margin="9,0" IsHitTestVisible="False"/>
          </Grid>
        </Grid>
        <DockPanel x:Name="ReasonRow" Margin="0,10,0,0">
          <Border DockPanel.Dock="Right" Background="{DynamicResource Soft}" CornerRadius="6"><StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Off" Content="Off · Faster" GroupName="Reasoning"/><RadioButton x:Name="Low" Content="Low" GroupName="Reasoning"/>
          </StackPanel></Border>
          <TextBlock Text="Reasoning"/>
        </DockPanel>
        <TextBlock x:Name="Destination" Style="{StaticResource Hint}" Margin="0,13,0,10" FontSize="12"/>
        <DockPanel>
          <Button x:Name="SaveButton" Content="Save settings" DockPanel.Dock="Right" Style="{StaticResource Primary}" Click="SaveProvider"/>
          <WrapPanel VerticalAlignment="Center">
            <Button x:Name="TestButton" Content="Test translation" Click="TestProvider" ToolTip="Send a sample to this provider. API usage may be billed."/>
            <Button x:Name="Remove" Content="Remove key" Style="{StaticResource Quiet}" Click="RemoveKey" Margin="3,0,0,0"/>
          </WrapPanel>
        </DockPanel>
        <TextBlock x:Name="SettingsStatus" Style="{StaticResource Feedback}" AutomationProperties.LiveSetting="Polite"/>
        <Border Height="1" Background="{DynamicResource Line}" Margin="0,20"/>
        <CheckBox x:Name="Replace" Content="Replace selected text while typing" Style="{StaticResource Switch}"/>
        <CheckBox x:Name="Floating" Content="Show button after selection" Style="{StaticResource Switch}"/>
        <CheckBox x:Name="WeChat" Content="Check WeChat selections with Copy" Style="{StaticResource Switch}" ToolTip="Temporarily copies an otherwise unreadable WeChat text selection to verify it."/>
        <DockPanel Margin="0,9,0,0">
          <Border DockPanel.Dock="Right" Background="{DynamicResource Soft}" CornerRadius="6"><StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Simplified" Content="简体中文" GroupName="Chinese"/><RadioButton x:Name="Traditional" Content="繁體中文" GroupName="Chinese"/>
          </StackPanel></Border>
          <TextBlock Text="Translate English to"/>
        </DockPanel>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="3" Margin="0,16,0,0">
      <TextBlock x:Name="VersionLabel" Style="{StaticResource Hint}" DockPanel.Dock="Right"/>
      <StackPanel Orientation="Horizontal"><TextBlock Text="✦" Foreground="{DynamicResource Muted}" Margin="0,0,7,0"/><TextBlock x:Name="ProviderFooter" Style="{StaticResource Hint}"/></StackPanel>
    </DockPanel>
  </Grid>
</local:ToolWindow>
