<Window x:Class="Translated.ShortcutEditor" x:ClassModifier="internal"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="自定义快捷键 · Translated" Width="1190" Height="790" MinWidth="870" MinHeight="660"
  WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{DynamicResource Paper}"
  Foreground="{DynamicResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Keycap" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Entry}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid>
              <Border x:Name="Base" Margin="0,4,0,0" CornerRadius="7" Background="{DynamicResource Line}">
                <Border.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity=".16"/></Border.Effect>
              </Border>
              <Border x:Name="Cap" Margin="0,0,0,4" CornerRadius="7" Background="{TemplateBinding Background}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Grid>
                  <Border CornerRadius="6" Margin="1" BorderThickness="1" BorderBrush="#25FFFFFF"/>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Cap" Property="Background" Value="{DynamicResource Sage}"/>
                <Setter TargetName="Cap" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Base" Property="Background" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Cap" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Cap" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Cap" Property="BorderThickness" Value="2"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Cap" Property="Margin" Value="0,3,0,1"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28,24,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <DockPanel>
      <Border DockPanel.Dock="Right" CornerRadius="14" Background="{DynamicResource Sage}" Padding="10,6"
        VerticalAlignment="Top">
        <TextBlock x:Name="RecordingState" Text="● 正在录制" Foreground="{DynamicResource Accent}" FontSize="12" FontWeight="SemiBold"/>
      </Border>
      <StackPanel>
        <TextBlock Text="让快捷键，顺手一点。" FontSize="26" FontWeight="Bold" Margin="0,0,0,8"/>
        <TextBlock Text="按下实体按键录制，或点击下面的键帽与鼠标侧键自由组合。" Style="{StaticResource Hint}"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Margin="0,22,0,16" Padding="18,14" CornerRadius="14"
      Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="CaptureButton" Content="暂停录制" Click="ToggleCapture" Style="{StaticResource Quiet}" Margin="0,0,12,0"/>
          <Button x:Name="ClearButton" Content="清空重录" Click="ClearClick" Style="{StaticResource Quiet}"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Text="当前组合" Style="{StaticResource Hint}" FontSize="11" Margin="0,0,0,6"/>
          <TextBlock x:Name="Combination" FontFamily="Consolas, Microsoft YaHei UI" FontSize="21" FontWeight="Bold"
            TextWrapping="Wrap" AutomationProperties.Name="当前快捷键组合" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="键盘" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="KeyboardDevice" Text="正在识别已连接键盘…" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,16,0"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="鼠标" FontSize="14" FontWeight="SemiBold"/>
            <TextBlock x:Name="MouseDevice" Text="正在识别已连接鼠标…" Style="{StaticResource Hint}" FontSize="11" Margin="0,4,0,0"/>
          </StackPanel>
        </Grid>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Border CornerRadius="17" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}"
              BorderThickness="1" Padding="10" Margin="0,0,18,8">
              <Border.Effect><DropShadowEffect BlurRadius="9" ShadowDepth="4" Opacity=".10"/></Border.Effect>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="MainKeys"/>
                <StackPanel x:Name="NavigationKeys" Grid.Column="1" Margin="10,0,0,0"/>
                <StackPanel x:Name="NumpadKeys" Grid.Column="2" Margin="10,50,0,0" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <Grid Width="177" Height="322">
              <Border Margin="14,2,0,0" CornerRadius="64,64,69,69" Background="{DynamicResource Line}"/>
              <Border Margin="12,0,2,5" CornerRadius="64,64,69,69" BorderBrush="{DynamicResource Line}" BorderThickness="1">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#EEE9DF" Offset="0"/><GradientStop Color="#D8D1C3" Offset=".5"/><GradientStop Color="#C4BBAC" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid>
                  <Border Width="1" Height="95" Background="#80978F80" VerticalAlignment="Top"/>
                  <Border Height="1" Background="#50978F80" Margin="9,96,9,0" VerticalAlignment="Top"/>
                  <TextBlock Text="TRANSLATED" Foreground="#80766F61" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,35"/>
                </Grid>
              </Border>
              <ToggleButton x:Name="MiddleKey" Tag="4" Content="中键" Width="30" Height="65" Margin="0,24,0,0"
                VerticalAlignment="Top" HorizontalAlignment="Center" Style="{StaticResource Keycap}" Click="MouseKeyClick" ToolTip="鼠标滚轮按下"/>
              <ToggleButton x:Name="Mouse5Key" Tag="6" Content="M5" Width="36" Height="56" Margin="0,111,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Keycap}" Click="MouseKeyClick" ToolTip="前侧键 / XButton2"/>
              <ToggleButton x:Name="Mouse4Key" Tag="5" Content="M4" Width="36" Height="56" Margin="0,171,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Keycap}" Click="MouseKeyClick" ToolTip="后侧键 / XButton1"/>
            </Grid>
          </StackPanel>
        </Viewbox>
        <DockPanel Margin="0,8,0,6">
          <CheckBox x:Name="ShowNumpad" Content="显示数字键盘" Click="NumpadClick" Style="{StaticResource Modifier}" DockPanel.Dock="Right"/>
          <TextBlock Text="绿色表示已选中 · 实体按住时键帽会下沉 · 再次点击键帽可取消" Style="{StaticResource Hint}" FontSize="11"/>
        </DockPanel>
        <TextBlock Text="显示通用布局，快捷键对已连接的所有键鼠生效。Fn 或厂商专用宏键需要先在设备驱动中映射为普通按键。"
          Style="{StaticResource Hint}" FontSize="11" Margin="0,3,0,0"/>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" CornerRadius="10" Background="{DynamicResource Field}" Padding="13,11" Margin="0,16,0,16">
      <TextBlock x:Name="Validation" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
    </Border>
    <DockPanel Grid.Row="4">
      <Button x:Name="SaveShortcutButton" Content="保存快捷键" Click="SaveClick" Style="{StaticResource Primary}" DockPanel.Dock="Right" MinWidth="130"/>
      <Button x:Name="CancelShortcutButton" Content="取消" Click="CancelClick" Style="{StaticResource Quiet}" DockPanel.Dock="Right" Margin="0,0,14,0"/>
      <TextBlock Text="只有保存后才会生效，取消保留原快捷键。" Style="{StaticResource Hint}" FontSize="12"/>
    </DockPanel>
  </Grid>
</Window>
